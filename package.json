{
  "name": "ki-mv-remake-projekt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ASTRA world.execute(me); original complete music-video renderer",
  "scripts": {
    "full:1080": "node tools/render/export_sample.mjs --entry src/full/index.html --width 1920 --height 1080 --fps 60 --start-frame 0 --end-frame 12740 --out exports/astra-world-execute-me-full-v1-1080p60.mp4",
    "full:4k": "node tools/render/export_full_parallel.mjs --out exports/astra-world-execute-me-full-v1-4k60.mp4",
    "sample:1080": "node tools/render/export_sample.mjs --width 1920 --height 1080 --out exports/astra-ending-sample-v01-1080p60.mp4",
    "sample:4k": "node tools/render/export_sample.mjs --width 3840 --height 2160 --out exports/astra-ending-sample-v01-4k60.mp4",
    "sample:stills": "node tools/render/export_sample.mjs --width 1920 --height 1080 --stills 193.066667,195.5,196.9,198.8,200.2,203.3,206.1,208.5,211.7 --out exports/qa",
    "sample:v02:1080": "node tools/render/export_sample.mjs --entry src/sample-v02/index.html --width 1920 --height 1080 --out exports/astra-ending-sample-v02-1080p60.mp4",
    "sample:v02:4k": "node tools/render/export_sample.mjs --entry src/sample-v02/index.html --width 3840 --height 2160 --out exports/astra-ending-sample-v02-4k60.mp4",
    "sample:v02:stills": "node tools/render/export_sample.mjs --entry src/sample-v02/index.html --width 1920 --height 1080 --stills 193.066667,195.5,196.9,198.583333,198.6,200.2,203.3,206.1,208.5,211.7 --out exports/qa-v02",
    "full:v2:4k": "node tools/render/export_full_v2_parallel.mjs",
    "full:v2:1080": "node tools/render/downscale_v2.mjs",
    "full:v2:qa": "node tools/render/qa_v2.mjs --out exports/qa-v2-final",
    "full:v2:data": "node tools/render/build_v2_data.mjs",
    "full:v3:data": "node tools/render/build_v3_data.mjs",
    "full:v3:assets": "node tools/render/merge_v3_assets.mjs",
    "full:v3:qa": "node tools/render/qa_v3.mjs --out exports/qa-v3-final",
    "full:v3:4k": "node tools/render/export_full_v3_parallel.mjs",
    "full:v3:1080": "node tools/render/downscale_v3.mjs",
    "full:v4:qa": "node tools/render/qa_v4.mjs --out exports/qa-v4-final",
    "full:v4:math": "node tools/render/check_neural_v4.mjs",
    "full:v4:4k": "node tools/render/export_full_v4_parallel.mjs",
    "full:v4:1080": "node tools/render/downscale_v4.mjs",
    "full:v4:upload": "node tools/render/package_v4_upload.mjs",
    "final:v5:assets": "node tools/render/merge_v5_assets.mjs",
    "final:v5:qa": "node tools/render/qa_v5.mjs --width 3840 --height 2160 --out exports/qa-v5-final",
    "final:v5:math": "node tools/render/check_neural_v5.mjs && node tools/render/check_v5_actions.mjs",
    "final:v5:4k-hires": "node tools/render/export_final_v5.mjs"
  },
  "dependencies": {
    "playwright-core": "1.64.1"
  }
}
