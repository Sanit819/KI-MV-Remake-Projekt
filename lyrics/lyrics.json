[
  {
    "id": 1,
    "latin": "Prata olim laeta nunc aruuntur,",
    "chinese": "昔日欢悦的原野，如今已然枯槁",
    "start": null,
    "end": null,
    "source": "user-provided"
  },
  {
    "id": 2,
    "latin": "et tempus fertile cum vento praeteriit.",
    "chinese": "丰饶时节，随风消逝",
    "start": null,
    "end": null,
    "source": "user-provided"
  },
  {
    "id": 3,
    "latin": "Venti per caelum flantes nobis nuntian,",
    "chinese": "长风穿穹而过，向我们宣告",
    "start": null,
    "end": null,
    "source": "user-provided"
  },
  {
    "id": 4,
    "latin": "tempus discedendi advenisse.",
    "chinese": "动身远行之时已至",
    "start": null,
    "end": null,
    "source": "user-provided"
  },
  {
    "id": 5,
    "latin": "Proficiscamur, ad novas terras,",
    "chinese": "启程吧，向着陌生的大地",
    "start": null,
    "end": null,
    "source": "user-provided"
  },
  {
    "id": 6,
    "latin": "cum amicis et familia.",
    "chinese": "偕亲友，同族人一道",
    "start": null,
    "end": null,
    "source": "user-provided"
  },
  {
    "id": 7,
    "latin": "Proficiscamur, ad mundum ditiorem.",
    "chinese": "启程吧，去往更为丰饶的国度",
    "start": null,
    "end": null,
    "source": "user-provided"
  },
  {
    "id": 8,
    "latin": "Noli respicire. Perge progredi.",
    "chinese": "勿回头，只管向前行",
    "start": null,
    "end": null,
    "source": "user-provided"
  },
  {
    "id": 9,
    "latin": "Montes sacri, protegite populum nostrum.",
    "chinese": "圣山啊，请庇佑吾民",
    "start": null,
    "end": null,
    "source": "user-provided"
  },
  {
    "id": 10,
    "latin": "Perge, vestigia integra pergunt.",
    "chinese": "前行，步履坚定不移",
    "start": null,
    "end": null,
    "source": "user-provided"
  },
  {
    "id": 11,
    "latin": "Per flumina et valles, progredimur.",
    "chinese": "跨河谷，越山涧，我们继续前行",
    "start": null,
    "end": null,
    "source": "user-provided"
  },
  {
    "id": 12,
    "latin": "Aliquando ad \"Hortus Regis Alti\" perveniemus.",
    "chinese": "终有一日，我们将抵达「至高之王的花园」",
    "start": null,
    "end": null,
    "source": "user-provided"
  },
  {
    "id": 13,
    "latin": "Revertimini ad terram nostram,",
    "chinese": "归去吧，回到故土之上",
    "start": null,
    "end": null,
    "source": "user-provided"
  },
  {
    "id": 14,
    "latin": "cum amicis et familia.",
    "chinese": "偕亲友，同族人一道",
    "start": null,
    "end": null,
    "source": "user-provided"
  },
  {
    "id": 15,
    "latin": "Revertimini ad mundum ditiorem.",
    "chinese": "归去吧，去往丰饶的国度",
    "start": null,
    "end": null,
    "source": "user-provided"
  },
  {
    "id": 16,
    "latin": "Noli dubitare. Proficisce te nunc.",
    "chinese": "不必迟疑，此刻就踏上旅途",
