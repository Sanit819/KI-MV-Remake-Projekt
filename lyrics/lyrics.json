        5
      ],
      "ja": "あの一等星のさんざめく光で",
      "zh": "在那一等星的喧嚣光芒之下",
      "start": null,
      "end": null,
      "timing_status": "unassigned"
    },
    {
      "id": "L002",
      "source_lines": [
        6,
        7
      ],
      "ja": "あなたとダンスを踊ろうか",
      "zh": "你我一起 来跳舞吧",
      "start": null,
      "end": null,
      "timing_status": "unassigned"
    },
    {
      "id": "L003",
      "source_lines": [
        8,
        9
      ],
      "ja": "我が太陽系の鼓動に合わせて",
      "zh": "让我们来伴着 太阳系的脉动",
      "start": null,
      "end": null,
      "timing_status": "unassigned"
    },
    {
      "id": "L004",
      "source_lines": [
        10,
        11
      ],
      "ja": "絡まったステップで綺羅めいて、星ッ！",
      "zh": "跳起交错的舞步 闪耀起光芒！星！",
      "start": null,
      "end": null,
      "timing_status": "unassigned"
    },
    {
      "id": "L005",
      "source_lines": [
        12,
        13
      ],
      "ja": "ランバダ ルンバ ふたり 宇宙（そら）でランデブーな",
      "zh": "朗巴得 伦巴  两个人 宇宙中相遇约会",
      "start": null,
      "end": null,
      "timing_status": "unassigned"
    },
    {
      "id": "L006",
      "source_lines": [
        14,
        15
      ],
      "ja": "妄、患（わずら）って 連夜眠れない",
      "zh": "如此得 妄想着 彻夜辗转难眠",
      "start": null,
      "end": null,
      "timing_status": "unassigned"
    },
    {
      "id": "L007",
      "source_lines": [
        16,
        17
      ],
      "ja": "星座になって 混ざる どんな一等星も",
      "zh": "不管是 混杂在星座中的哪种一等星都好",
      "start": null,
      "end": null,
      "timing_status": "unassigned"
    },
    {
      "id": "L008",
      "source_lines": [
        18,
        19
      ],
      "ja": "あなたに 代わる 光度はないわ",
      "zh": "能够和你争辉的 一颗都没有",
      "start": null,
      "end": null,
      "timing_status": "unassigned"
    },
    {
      "id": "L009",
      "source_lines": [
        20,
        21
      ],
      "ja": "校舎の裏 あの日 あなた見つけた",
      "zh": "校舍后面 那一天 发现了你",
      "start": null,
      "end": null,
      "timing_status": "unassigned"
    },
    {
      "id": "L010",
      "source_lines": [
        22,
        23
      ],
      "ja": "奇跡さえ 今も はなれない",
      "zh": "如同奇迹，至今也无法忘记",
      "start": null,
      "end": null,
      "timing_status": "unassigned"
    },
    {
      "id": "L011",
      "source_lines": [
        24,
        25
      ],
      "ja": "隣に 繁（しげ）く 見える 冥王星も",
      "zh": "你旁边 那颗经常能看见的冥王星",
      "start": null,
      "end": null,
      "timing_status": "unassigned"
    },
    {
      "id": "L012",
      "source_lines": [
        26,
        27
      ],
      "ja": "生憎（あいにく）、今は 興味がないわ",
      "zh": "也因你在，光芒早已黯淡",
      "start": null,
      "end": null,
      "timing_status": "unassigned"
    },
    {
      "id": "L013",
      "source_lines": [
        28,
        29
      ],
      "ja": "星が舞っちゃって",
      "zh": "星辰正在来回旋绕",
      "start": null,
      "end": null,
      "timing_status": "unassigned"
    },
    {
      "id": "L014",
      "source_lines": [
        30,
        31
      ],
      "ja": "胸が鳴っちゃって",
      "zh": "心脏也在扑通直跳",
      "start": null,
      "end": null,
      "timing_status": "unassigned"
    },
    {
      "id": "L015",
      "source_lines": [
        32,
        33
      ],
      "ja": "気付けば彼方―――",
      "zh": "能察觉到吗 那边的你",
      "start": null,
      "end": null,
      "timing_status": "unassigned"
    },
    {
      "id": "L016",
      "source_lines": [
        34,
        35
      ],
      "ja": "あの一等星のさんざめく光で",
      "zh": "那颗一等星正在放着喧嚣的光芒",
      "start": null,
      "end": null,
      "timing_status": "unassigned"
    },
    {
      "id": "L017",
      "source_lines": [
        36,
        37
      ],
      "ja": "あなたとダンスを踊ろうか",
      "zh": "我们一起来跳舞怎么样",
      "start": null,
      "end": null,
      "timing_status": "unassigned"
    },
    {
      "id": "L018",
      "source_lines": [
        38,
        39
      ],
      "ja": "我が太陽系の法則に誘われ",
      "zh": "我被太阳系的引力所捕获",
      "start": null,
      "end": null,
      "timing_status": "unassigned"
    },
    {
      "id": "L019",
      "source_lines": [
        40,
        41
      ],
      "ja": "交わった感度で綺羅めいて、星ッ！",
      "zh": "相互照耀，闪耀起光芒！星！",
      "start": null,
      "end": null,
      "timing_status": "unassigned"
    },
    {
      "id": "L020",
      "source_lines": [
        42,
        43
      ],
      "ja": "オー・オ・オー！",
      "zh": "噢——噢，噢——！",
      "start": null,
      "end": null,
      "timing_status": "unassigned"
    },
    {
      "id": "L021",
      "source_lines": [
        44,
        45
      ],
      "ja": "星間線を絆いで (オー・オ・オー！)",
